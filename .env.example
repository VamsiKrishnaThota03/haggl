# Copy this file to .env and fill in the values. Never commit .env.

# --- PayPal (free sandbox) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI (free) ---
# aistudio.google.com/apikey -> Create API key (free tier, no credit card)
# Leave empty to run the built-in offline negotiator instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Server ---
PORT=3000
# Loopback by default. Only change this when deploying (see README).
HOST=127.0.0.1
